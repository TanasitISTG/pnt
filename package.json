{
  "name": "pnt",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "generate-routes": "bun run --cwd apps/web generate-routes",
    "build": "bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview",
    "test": "bun run --cwd apps/web test",
    "test:integration": "bun run --cwd apps/web test:integration",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "audit:release": "bun audit --audit-level=moderate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "bun run --cwd apps/web typecheck",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "db:generate": "bun run --cwd apps/web db:generate",
    "db:migrate": "bun run --cwd apps/web db:migrate",
    "db:migrate:test": "bun run --cwd apps/web db:migrate:test",
    "postbuild": "bun run --cwd apps/web postbuild",
    "seed:user": "bun run --cwd apps/web seed:user",
    "eval:translation": "bun run --cwd apps/web eval:translation",
    "publish:mynovel": "bun run --cwd apps/web publish:mynovel",
    "inngest": "bun run --cwd apps/web inngest",
    "doctor": "bun run --cwd apps/web doctor"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260717-080150-bfc2f5ef",
    "oxfmt": "0.59.0",
    "oxlint": "1.85.0"
  },
  "resolutions": {
    "postcss/nanoid": "3.3.18"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "baseline-browser-mapping": "2.11.23",
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.9",
    "dompurify": "3.4.14",
    "esbuild": "0.25.12",
    "fast-uri": "3.1.6",
    "gaxios": "7.3.0",
    "js-yaml": "4.3.2",
    "postcss": "8.5.23",
    "undici": "7.29.0"
  },
  "packageManager": "bun@1.3.14",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "trustedDependencies": [
    "inngest-cli",
    "sharp"
  ]
}
