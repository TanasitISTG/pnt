{
  "name": "pnt",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude '**/*.integration.test.ts' --exclude 'e2e/**'",
    "test:integration": "vitest run src/lib/translation/workflow/workflow.integration.test.ts src/lib/inngest/outbox.integration.test.ts src/lib/translation/workflow/chunk-migration.integration.test.ts src/lib/export/stream.integration.test.ts src/lib/content/novel-maintenance.integration.test.ts src/lib/content/chapter-edit.integration.test.ts src/lib/content/publish.integration.test.ts src/lib/import/workflow.integration.test.ts src/lib/epub/import.integration.test.ts src/lib/job-dashboard/service.integration.test.ts src/lib/glossary/service.integration.test.ts src/lib/translation/evaluation/eval.integration.test.ts src/lib/auth/session-revocation.integration.test.ts src/lib/rate-limit.integration.test.ts src/lib/reader/reader-state.integration.test.ts --fileParallelism=false --reporter=dot",
    "test:e2e": "bun scripts/e2e/run.ts",
    "audit:release": "bun audit --audit-level=moderate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "storage:migrate": "bun scripts/storage-migrate.ts",
    "db:migrate:test": "bun scripts/migrate-test-db.ts",
    "postbuild": "bun scripts/postbuild.ts",
    "seed:user": "bun scripts/seed-user.ts",
    "eval:translation": "bun scripts/eval-translation.ts",
    "publish:mynovel": "bun scripts/publish-mynovel.ts",
    "inngest": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "doctor": "react-doctor"
  },
