{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    // nitro build output: bundled third-party deps, gitignored, regenerated by `bun run build`
    "files": [".output/**"],
    "overrides": [
      {
        // Sequential by design: chunk N+1 reads chunk N's translation as
        // context (worker.ts previousChunkTail), and step.run order is the
        // Inngest resume mechanism. Parallel = broken context + broken resume.
        "files": ["src/lib/inngest/functions.ts"],
        "rules": ["react-doctor/async-await-in-loop"]
      }
    ]
  }
}
