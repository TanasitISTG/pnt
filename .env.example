[TEMPLATE]
# PostgreSQL TCP connection string. Must be the provider's POOLED endpoint where one exists
# (on Neon, the host carrying the `-pooler` suffix): every serverless instance keeps a single
# connection, the pooler multiplexes that fan-out onto few server connections, and the client
# runs with `prepare: false` so it is safe behind transaction pooling.
DATABASE_URL=postgresql://user:password@host-pooler.example.com/dbname?sslmode=require

# The matching DIRECT (unpooled) endpoint, used by `bun run db:migrate` and drizzle-kit.
# Migrations run DDL and prepared statements, which need a real session that a transaction-mode
# pooler does not guarantee. On Neon this is the same host without the `-pooler` suffix. Set it
# equal to DATABASE_URL when the deployment has no pooler (local Postgres, or a provider without one).
DATABASE_URL_UNPOOLED=

# Connection ceiling for the pooled client. Leave empty (or omit) in production: one
# connection per serverless instance is deliberate. Integration suites that hold a row
# lock across two concurrent transactions raise it, because a single connection
# serializes those requests client-side instead of letting Postgres arbitrate the lock.
DATABASE_POOL_MAX=

# Isolated database for `bun run test:integration` — never the application database.
# Local PostgreSQL example: postgresql://postgres:1234@localhost:5432/pnt_integration
# Create it and apply migrations with: bun run db:migrate:test
TEST_DATABASE_URL=

# Sign-in attempts allowed per address per minute. Leave empty for the shipped ten; the E2E
# supervisor raises it, because a whole suite signs in from one address inside one window.
AUTH_RATE_LIMIT_MAX=

# Better Auth — generate with: bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64())"
BETTER_AUTH_SECRET=
# Base URL of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# AES-256-GCM key for encrypting provider API keys at rest — 32 bytes, base64
# Generate with: bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64())"
APP_ENCRYPTION_KEY=

# Provider transport: public HTTPS only by default. Exact origins opt into local/private
# addresses and HTTP, without disabling TLS verification or allowing redirects.
# Canonical JSON origins only: no trailing slash/path/query/credentials/default-port alias.
# Example: LOCAL_PROVIDER_ORIGINS='["http://127.0.0.1:4010"]'
LOCAL_PROVIDER_ORIGINS=[]

# Trusted X-Forwarded-For hops (integer >= 0). Default 0 trusts no client IP headers.
# Enable only behind a controlled proxy chain that cannot be bypassed directly.
# Missing/invalid identity skips guest IP limiting; limiter storage errors fail open.
# On Vercel (VERCEL=1) the client IP comes from x-vercel-forwarded-for / x-real-ip
# instead, so this stays 0 there; set a hop count only for non-Vercel proxies.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# Cloudflare R2 object storage. Optional locally (a filesystem adapter under
# .tura/storage/ is used instead) and required on Vercel, where all six must be set.
# Covers are served from R2_PUBLIC_BASE_URL; EPUB uploads and cached exports live in
# the private bucket and are reached only through signed URLs or the app itself.
# R2_PUBLIC_BASE_URL must be the bucket's custom domain: canonical HTTPS origin, no slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional: seed operator credentials (used by `bun run seed:user`). The seeded account
# is the only way to obtain the admin role — public sign-up can never produce it.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# Transactional email (Resend). Optional: without it the mailer logs the message instead
# of sending it, which is how local dev and CI finish a password reset or a verification
# without a mail account. Both or neither — a lone half silently drops every message.
RESEND_API_KEY=
# A verified sender on the Resend domain, e.g. "Pnt <no-reply@example.com>"
EMAIL_FROM=

# Cloudflare Turnstile captcha on sign-up, sign-in, and password reset. Optional: the
# plugin registers only when the secret is present, so dev and CI need no keys.
# Both or neither; the site key is public and handed to the browser by the server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OAuth sign-in. Each provider is registered only when both halves are set, so a
# half-configured provider never renders a button whose callback cannot complete.
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/{google|discord}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Set by Vercel on every deployment and trusted as auth origins, so OAuth and the auth
# client work on a preview URL before a custom domain is attached. Leave empty locally.
VERCEL_URL=
VERCEL_BRANCH_URL=

# Inngest — local dev: set INNGEST_DEV=1 (SDK v4 defaults to cloud mode), no keys needed
INNGEST_DEV=1
# Production (Inngest Cloud): from the Inngest dashboard — leave empty locally
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ZenRows scraper proxy configuration (optional, required for twkan.com / biquge.tw anti-bot bypass)
SCRAPER_API_KEY=
SCRAPER_BASE=https://api.zenrows.com/v1/
SCRAPER_RENDER_JS=false
SCRAPER_PREMIUM_PROXY=true

# ScrapingBee API key (optional)
SCRAPINGBEE_API_KEY=

# Firecrawl API key (optional)
FIRECRAWL_API_KEY=

# Optional: PostHog analytics (only active in production builds)
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# The language the app ships in, `th` or `en`; anything else fails the build. Thai is the
# unprefixed language, so this decides which URLs carry a locale prefix — see i18n.md §2.
# Leave empty for `th`. It is baked into the client bundle, so changing it is a rebuild.
VITE_DEFAULT_LOCALE=
