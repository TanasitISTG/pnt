# PostgreSQL / CockroachDB TCP connection string.
# The serverless application pool is capped at 3 connections per process.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Isolated database for `bun run test:integration` — never the application database.
# Local PostgreSQL example: postgresql://postgres:1234@localhost:5432/pnt_integration
# Create it and apply migrations with: bun run db:migrate:test
TEST_DATABASE_URL=

# Better Auth — generate with: bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64())"
BETTER_AUTH_SECRET=
# Base URL of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# AES-256-GCM key for encrypting provider API keys at rest — 32 bytes, base64
# Generate with: bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).toBase64())"
APP_ENCRYPTION_KEY=

# Provider transport: public HTTPS only by default. Exact origins opt into local/private
# addresses and HTTP, without disabling TLS verification or allowing redirects.
# Canonical JSON origins only: no trailing slash/path/query/credentials/default-port alias.
# Example: LOCAL_PROVIDER_ORIGINS='["http://127.0.0.1:4010"]'
LOCAL_PROVIDER_ORIGINS=[]

# Trusted X-Forwarded-For hops (integer >= 0). Default 0 trusts no client IP headers.
# Enable only behind a controlled proxy chain that cannot be bypassed directly.
# Missing/invalid identity skips guest IP limiting; limiter storage errors fail open.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# Optional: seed admin credentials (used by `bun run seed:user`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# Inngest — local dev: set INNGEST_DEV=1 (SDK v4 defaults to cloud mode), no keys needed
INNGEST_DEV=1
# Production (Inngest Cloud): from the Inngest dashboard — leave empty locally
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ZenRows scraper proxy configuration (optional, required for twkan.com / biquge.tw anti-bot bypass)
SCRAPER_API_KEY=
SCRAPER_BASE=https://api.zenrows.com/v1/
SCRAPER_RENDER_JS=false
SCRAPER_PREMIUM_PROXY=true

# ScrapingBee API key (optional)
SCRAPINGBEE_API_KEY=

# Firecrawl API key (optional)
FIRECRAWL_API_KEY=

# Optional: PostHog analytics (only active in production builds)
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com